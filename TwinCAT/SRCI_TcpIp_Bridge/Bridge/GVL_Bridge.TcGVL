//    own risk and responsibility.
//
// -------------------------------------------------------------------------
VAR_GLOBAL
  /// EcMaster State	
  EcMasterState AT %I*: UINT;
  /// EcSlave State	
  EcSlaveState  AT %I*: UINT;
  /// Telegram RC -> PLC: PROFINET inputs of the robot (link to the input module(s) of the RC)
  RobotInData  AT %I* : ARRAY[0..255] OF BYTE;
  /// Telegram PLC -> RC: PROFINET outputs of the robot (link to the output module(s) of the RC)
  RobotOutData AT %Q* : ARRAY[0..255] OF BYTE;
  /// TCP/IP server for the SRCI client in Python
  Bridge              : FB_SrciTcpIpBridge;
END_VAR]]></Declaration>
  </GVL>
</TcPlcObject>