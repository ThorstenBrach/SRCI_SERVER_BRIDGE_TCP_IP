<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.16">
  <GVL Name="GVL_Bridge" Id="{c956e611-78a2-48e5-817f-e84790581c43}">
    <Declaration><![CDATA[{attribute 'qualified_only'}
// -------------------------------------------------------------------------
//  SRCI Robot Library
// -------------------------------------------------------------------------
//
//  Object:      GVL_Bridge
//  Author:      Thorsten Brach
//  Date:        2026-10-02
//
//  Description:
//    PROFINET process data of the robot and the TCP/IP bridge instance.
//
